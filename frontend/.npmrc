# This project's peer dependencies cannot all be satisfied at once.
#
#   react-scripts@5.0.1  peerOptional typescript "^3.2.1 || ^4"
#   viem@2.55.19         peerOptional typescript ">=5.0.4"
#   wagmi@2.19.5         peerOptional typescript ">=5.0.4"
#
# Those ranges do not overlap. Marking a peer `optional` only tells npm the
# package may be absent; once typescript is present -- and it is, pinned at
# ^4.9.5 in devDependencies -- npm enforces every declared range against it
# and aborts with ERESOLVE. Pinning typescript 5.x does not help, it only
# moves the violation over to react-scripts.
#
# Relaxing peer resolution does NOT change which versions get installed:
# package-lock.json still decides that, and `npm ci` reproduces it exactly.
# All this does is stop npm refusing to act on a conflict it cannot resolve.
#
# Drop this line once the app moves off react-scripts 5 (Vite, or CRA eject).
legacy-peer-deps=true
